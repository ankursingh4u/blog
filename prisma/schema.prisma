// FixDesk data model.
//
// Postgres everywhere, development included. It began on SQLite with the
// intention of switching only in production, but the two engines disagree in
// ways that bite silently — `contains` is case-insensitive on SQLite and
// case-sensitive on Postgres, so site search behaves differently in production
// than it did in dev, with nothing to signal it. One engine, no divergence.
//
// JSON columns are stored as String and parsed through Zod in src/lib/json.ts,
// which is why the move needed no schema rewrite at all.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum GeneratedBy {
  AI
  HUMAN
}

enum KeywordSource {
  FEED
  MANUAL
}

enum KeywordStatus {
  QUEUED
  USED
  SKIPPED
}

model Author {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  avatar        String?
  bio           String
  categoryFocus String   @default("[]") // JSON array of category slugs
  stylePrompt   String
  createdAt     DateTime @default(now())

  // A reader whose submitted article was accepted, as opposed to one of the
  // house bylines. Guests are excluded from the generation pool: assignAuthor
  // falls back to every author when none matches a category, which would
  // otherwise put a contributor's name on an article they did not write.
  isGuest Boolean @default(false)
  // Contact address for a guest, used to recognise a repeat contributor rather
  // than creating a second byline for the same person. Never shown publicly.
  email   String?

  posts Post[]

  @@index([slug])
  @@index([email])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An article sent in through the public form at /write.
///
/// Deliberately a separate table rather than a Post with an extra status.
/// Anyone on the internet can create one of these, so nothing here has been
/// read by a human yet: keeping it out of Post means unreviewed text can never
/// be reached by a query that forgot to filter on status, and the public site
/// cannot render it by accident.
model Submission {
  id    String @id @default(cuid())
  title String
  body  String

  /// Contributor's own name, shown as the byline if it is published.
  authorName  String
  /// Contact address. Stored for replies, never rendered on the public site.
  authorEmail String

  /// Where the contributor thinks it belongs. Advisory — the editor decides.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// JSON array of { url, alt, width, height } already written to storage.
  images String @default("[]")

  status SubmissionStatus @default(PENDING)
  /// Editor's note, e.g. why it was rejected. Internal only.
  note   String?

  /// Set once accepted, so the queue links through to what it became.
  postId String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
}

model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  // Ordering on the homepage / nav. Lower sorts first.
  position    Int    @default(0)
  accent      String @default("violet")

  // Optional parent, for sub-sections such as /tech/windows. One level only —
  // a child may not itself have children. Posts may live in either a top-level
  // category or a child; src/lib/urls.ts derives the URL depth from this.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  posts       Post[]
  keywords    Keyword[]
  submissions Submission[]

  @@index([slug])
  @@index([parentId, position])
}

model Post {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  status PostStatus @default(DRAFT)

  quickAnswer    String
  body           String
  affectedBuilds String @default("[]") // JSON array of strings
  faq            String @default("[]") // JSON array of { question, answer }

  metaTitle       String
  metaDescription String
  featuredImage   String?
  // Attribution for `featuredImage` when it is an openly-licensed photograph
  // rather than a generated card. CC-BY and CC-BY-SA require the creator,
  // licence and a link back, so the data has to travel with the image or the
  // site cannot legally display it.
  // JSON: { creator, creatorUrl, license, licenseUrl, sourceUrl, sourceName, title }
  imageCredit     String  @default("")
  screenshots     String  @default("[]") // JSON array of { url, alt, width, height }
  sourceUrls      String  @default("[]") // JSON array of { url, title }

  // Auto-suggested + editor-confirmed internal links, JSON array of post slugs.
  relatedSlugs String @default("[]")

  qualityScore Int?
  qualityNotes String?

  generatedBy    GeneratedBy @default(AI)
  testedOnBuild  String?
  lastVerifiedAt DateTime?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId, status, publishedAt])
  @@index([slug])
}

model Keyword {
  id     String @id @default(cuid())
  phrase String @unique

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  source KeywordSource @default(FEED)
  status KeywordStatus @default(QUEUED)

  // Verified identifiers lifted from the source feed. The generator may only
  // use identifiers that appear here — see src/pipeline/quality-gate.ts.
  kbNumber    String?
  buildNumber String?
  errorCode   String?
  sourceUrl   String?

  // Masthead taken off the Google News headline ("Headline - Publisher").
  // Kept because over half of News links point at news.google.com rather than
  // the publisher, so the destination host cannot attribute the story and
  // showing a reader "news.google.com" as the source is worse than nothing.
  publisher String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([categoryId, status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
