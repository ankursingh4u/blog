# ---- Database -------------------------------------------------------------
# Local dev uses SQLite. The schema is Postgres-compatible: to move to Supabase,
# change provider in prisma/schema.prisma to "postgresql" and point this at the
# pooled connection string. No model changes are required.
DATABASE_URL="file:./dev.db"

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="FixDesk"

# ---- AI generation --------------------------------------------------------
# Never commit a real key. The pipeline refuses to run without this set.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# ---- Go-live only (phase 5) ----------------------------------------------
# Shared secret for /api/cron/generate when deployed behind Vercel Cron.
CRON_SECRET=""

# Admin sign-in. Required — with this unset /admin is closed, not open.
ADMIN_PASSWORD=""
# Optional. Signs the session cookie; falls back to ADMIN_PASSWORD if unset.
AUTH_SECRET=""
