# ---- Database -------------------------------------------------------------
# Postgres in every environment, development included. There is no SQLite
# fallback: the two engines disagree silently (`contains` is case-insensitive on
# SQLite, case-sensitive on Postgres), which made site search behave differently
# in production with nothing to signal it.
# Needed during `next build` as well as at runtime — the build pre-renders the
# article and author pages and queries the database to do it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fixdesk"

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="FixDesk"

# ---- AI generation --------------------------------------------------------
# Never commit a real key. The pipeline refuses to run without this set.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# ---- Production -----------------------------------------------------------
# Shared secret for /api/cron/generate, sent as `Authorization: Bearer ...` by
# the Coolify scheduled task. Unset means the route refuses everything rather
# than defaulting open.
CRON_SECRET=""

# Admin sign-in. Required — with this unset /admin is closed, not open.
ADMIN_PASSWORD=""
# Optional. Signs the session cookie; falls back to ADMIN_PASSWORD if unset.
AUTH_SECRET=""

# Coolify deploy target (server API). Never commit the real token.
COOLIFY_URL=""
COOLIFY_API_TOKEN=""
