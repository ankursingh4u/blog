node_modules
.next
out
build
.env
.env*.local
*.tsbuildinfo
next-env.d.ts
prisma/dev.db
prisma/dev.db-journal
# public/uploads is versioned deliberately. The featured images are the site's
# content, not build output — they must exist the moment the container starts or
# every article renders without a cover. In production this path is also a
# persistent volume, which Docker seeds from the image on first mount, so these
# files become the volume's initial contents and later admin uploads land beside
# them and survive redeploys.
.DS_Store
.vercel
coverage

# Pipeline run logs (backfill.log, measure-batch.log). Useful while a long run
# is going; not worth versioning.
*.log

# Per-machine Claude Code permissions, not project configuration.
.claude/settings.local.json

# Content backups from scripts/export-data.ts. Every article in one file —
# keep it out of the repo and somewhere off this machine.
data-export.json
*-export.json

# Scratch output from the cover-photo picker.
*.tmp
